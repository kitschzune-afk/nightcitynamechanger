<Window x:Class="Ncnc.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Night City Name Changer" Width="1280" Height="940" MinWidth="980" MinHeight="720" Background="#0B1118" Foreground="#EAF3F6" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="NIGHT CITY / NAME CHANGER" FontSize="28" FontWeight="Bold" Foreground="#F4E94E"/><TextBlock Text="YOUR NAME. YOUR STORY.   /   ENGLISH TEXT LOCALIZATION" Foreground="#93A9B8" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="InstallStatus" Text="Not installed" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#62D9C5"/></DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="18" Margin="0,0,0,16">
   <Grid x:Name="Inputs"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0"><TextBlock Text="CHARACTER TO RENAME" Foreground="#93A9B8" Margin="0,0,0,8"/><ComboBox x:Name="CharacterBox" DisplayMemberPath="Display" SelectionChanged="CharacterChanged" Margin="0,0,0,8"/><CheckBox x:Name="RenameEnabled" Content="Include this character in the mod" Click="EnabledChanged" Margin="0,0,0,8"/><TextBox x:Name="NameBox" Text="Johnny" FontSize="23" TextChanged="NameChanged"/><TextBlock Text="Enable, rename, then choose another character. Spoken audio is unchanged." TextWrapping="Wrap" Foreground="#93A9B8" Margin="0,9,0,0"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="CYBERPUNK 2077 INSTALLATION" Foreground="#93A9B8" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGame" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Detect" Click="DetectGame" Margin="8,0,0,0"/><TextBox x:Name="GameBox" TextChanged="GameChanged"/></DockPanel>
     <TextBlock x:Name="AliasText" TextWrapping="Wrap" Foreground="#93A9B8" Margin="0,8,0,0"/><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Toolchain…" Click="BrowseTool" Margin="8,0,0,0"/><TextBox x:Name="ToolBox" ToolTip="WolvenKit.CLI.exe" TextChanged="GameChanged"/></DockPanel>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2">
   <WrapPanel x:Name="CategoriesPanel" Margin="0,0,0,16"><CheckBox x:Name="Dialogue" Content="Dialogue subtitles" IsChecked="True" Click="CategoryChanged"/><CheckBox x:Name="Journal" Content="Quest journal" IsChecked="True" Click="CategoryChanged"/><CheckBox x:Name="Messages" Content="Messages &amp; shards" IsChecked="True" Click="CategoryChanged"/><CheckBox x:Name="UI" Content="User interface" IsChecked="True" Click="CategoryChanged"/></WrapPanel>
   <DockPanel Margin="0,0,0,10"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel operation" Click="Cancel" IsEnabled="False"/><WrapPanel x:Name="Actions"><Button Content="1  Scan &amp; preview" Click="ScanClick"/><Button Content="2  Generate mod" Click="GenerateClick" Background="#F4E94E" Foreground="#101820"/><Button Content="3  Install mod" Click="InstallClick"/><Button Content="Uninstall mod" Click="UninstallClick"/><Button Content="Restore defaults" Click="RestoreClick"/><Button Content="Approve all" Click="ApproveAllClick" ToolTip="Approve all candidates for the chosen character in enabled categories, ignoring search. Unclassified entries are assigned to UI when UI is enabled."/></WrapPanel></DockPanel>
   <TextBlock Text="Preview shows the chosen character. Generate combines all enabled characters. Approve all may replace unrelated names or instances of the letter V." Foreground="#E8BA70" FontSize="11" Margin="0,0,0,12"/>
  </StackPanel>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Export preview" Click="ExportClick" Padding="9,4"/><CheckBox x:Name="ShowUnclassified" DockPanel.Dock="Right" Content="Show unclassified" Click="FilterChanged"/><TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" TextChanged="FilterChanged" ToolTip="Filter by text, key or resource"/><TextBlock x:Name="CountText" Text="Scan the installed English resources to begin." VerticalAlignment="Center" Foreground="#93A9B8"/></DockPanel>
   <DataGrid x:Name="Preview" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="#101921" Foreground="#EAF3F6" RowBackground="#101921" AlternatingRowBackground="#16232D" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#25343F" BorderBrush="#334754" SelectionChanged="SelectionChanged" CellEditEnding="Edited" RowHeight="42" HeadersVisibility="Column">
    <DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="130" IsReadOnly="True"/></DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="2" Background="#151E26" Padding="12" Margin="0,8,0,8"><DockPanel><StackPanel DockPanel.Dock="Right" Width="165" Margin="12,0,0,0"><ComboBox x:Name="AssignCategory" Margin="0,0,0,7"/><Button Content="Approve selected" Click="ApproveClick" Padding="8,6" Margin="0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Detail" Text="Select a row to see its localization ID, source path, and classification evidence. Approving an entry confirms that every proposed name substitution in that entry refers to the chosen character." TextWrapping="Wrap" Foreground="#B9CCD8"/></ScrollViewer></DockPanel></Border>
  </Grid>
  <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="5" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="4" Background="#24323E" Foreground="#F4E94E"/><TextBlock x:Name="Status" Text="Ready • Source review and in-game verification are tracked separately." Foreground="#93A9B8" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
