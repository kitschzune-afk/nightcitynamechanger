<Application x:Class="Ncnc.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#151E26"/><SolidColorBrush x:Key="Accent" Color="#F4E94E"/>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0C131A"/><Setter Property="Foreground" Value="#EDF3F6"/><Setter Property="BorderBrush" Value="#3C4B57"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#F4E94E"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#24323E"/><Setter Property="Foreground" Value="#EAF3F6"/><Setter Property="BorderBrush" Value="#465966"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF3F6"/><Setter Property="Margin" Value="0,0,24,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22313D"/><Setter Property="Foreground" Value="#F4E94E"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5"/></Style>
 </Application.Resources>
</Application>
